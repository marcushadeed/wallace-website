<header class="site-header{% if hide_header_logo %} site-header--no-logo{% endif %}">
  <div class="container site-header__inner">
    {%- if not hide_header_logo %}
    <a class="site-header__logo" href="/">
      <img src="/assets/img/logo.svg" width="2084" height="555" alt="{{ site.name }} home">
    </a>
    {%- endif %}
    <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
